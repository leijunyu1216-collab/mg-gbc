 },
 "preprocessing": {
  "loader": "src.datasets._from_openml(name, data_id)",
  "encoding": "src.datasets._encode_frame: numeric columns pass through; true/false, yes/no and 0/1 nominal columns become 0/1; every other nominal column becomes its integer factor code; rows holding a non-finite value are dropped. No scaling, no feature selection, no imputation, no target encoding.",
  "md5_check": "The recorded md5_checksum of each admitted version is written into the result rows so a later re-download that changes the file is visible.",
  "k": "clip(round(sqrt(n)), 5, 10), computed from the frozen row count, never from the labels",
  "class_count_note": "C >= 2 rather than C >= 3 because the declared domain already contains a binary data set (wilt, in the development cohort): the rare-core predicate is defined per ball and does not need three classes."
 },
