{
 "protocol_id": "OPENML-HELDOUT-20261024-v1",
 "frozen_at": "2026-10-25T18:35:32+08:00",
 "supersedes": null,
 "purpose": "A held-out benchmark cohort that answers the in-sample-fixing objection directly. Every constant of MG-GBC was chosen on the development data of Sections 4.2-4.8. This protocol scores a cohort of real public classification data sets that took no part in any of those decisions, once, at the frozen defaults, against pre-declared criteria.",
 "evidence_tier": "Held-out cohort. The data sets are independent sources, so the paired statistic is a cross-source statement, unlike the temporal blocks of Sections 4.7-4.8, which are repeated measures inside one capture. Cohort membership is decided without labels; the rare subset inside it is a property of the data, not a selection.",
 "design_principle": "The cohort is the whole admissible population of a fixed id block, so there is no stopping rule to tune. The universe is OpenML data ids 1-10000; numpy's default_rng(SEED=20261024) permutes it; a data set is admissible when it is an active ARFF classification task with exactly one nominal target, 300 <= n <= 20000, C >= 2, 3 <= d <= 100 usable features, no missing values, not part of the development history, and the first drawn data set of its source. Every admissible data set is admitted, in draw order, and the draw order decides only which member of a variant family represents its source. No class-rarity quantity enters membership and no model was fitted while this document was being written, so no data set entered or left the cohort because of how rare its classes are or how either method performs on it. The two analysis subsets are defined after membership by the rare band the manuscript already uses, and the pre-registered criteria name which subset each of them is evaluated on.",
 "source": {
  "name": "every admissible OpenML data set in the fixed id block 1-10000; numpy.random.default_rng(20261024).permutation decides the order in which the block is walked and which member of a source family is admitted (10000 ids drawn, 95 admitted)",
  "surface": "https://api.openml.org/api/v1/json/data/qualities/{id} and /data/features/{id} for the screen; /data/{id} for admissible candidates",
  "download_surface": "src.datasets._from_openml, i.e. sklearn.datasets.fetch_openml(data_id=..., as_frame=True, parser='auto')",
  "official_reference": "Vanschoren, van Rijn, Bischl and Kotthoff, 2014 (OpenML)",
  "accessed_at": "2026-10-25",
  "license_note": "Public OpenML data sets; no authentication used.",
  "screen_log": "results/openml_heldout_screen_log.json",
  "superseded_screen_logs": [
   "results/openml_heldout_screen_log_labelfiltered_v0.json: the walk of the first design, in which the smallest class size was a membership condition",
   "results/openml_heldout_screen_log_ascending_v1.json: the walk of the second design, the first 120 admissible data sets in ascending id order"
  ]
 },
 "screen": {
  "id_universe": [
   1,
   10000
  ],
  "draw": {
   "generator": "numpy.random.default_rng(SEED).permutation(arange(1, ID_MAX + 1))",
   "seed": 20261024,
   "ids_drawn": 10000,
   "last_id_drawn": 8457,
   "order": "permutation order; every admissible data set is taken, one per source, so the order decides which variant of a family is admitted and nothing else",
   "cohort_listed_by": "ascending data id, for readability; membership is the draw order"
  },
  "cohort_size": 95,
  "cohort_size_is_a_maximum": false,
  "cohort_size_rule": "There is no cap. The cohort is every admissible data set in the id block, so its size is a property of the repository and of the declared domain, not a parameter.",
  "source_rule": "The source of a data set is the first separator-delimited token of its name with digits removed, so volcanoes-a2 and volcanoes-b1, fri_c3_1000_25 and fri_c4_500_50, chscase_census2 and chscase_census6, mfeat-fourier and mfeat-zernike are each one source, and only the first drawn is admitted. The rule is coarse on purpose: it can merge data sets that are in fact distinct (analcatdata_authorship with analcatdata_dmft, kc1 with kc2), which costs the cohort a member, but it cannot let one uploader's variant family occupy several places in it.",
  "min_rare_to_freeze": 6,
  "min_control_to_freeze": 20,
  "structural_conditions": [
   "status == 'active' and format == 'ARFF'",
   "exactly one target feature and its data type is nominal",
   "300 <= n <= 20000",
   "C >= 2, a task-validity condition: a data set with one class has no partition to recover",
   "3 <= d <= 100 usable features",
   "NumberOfMissingValues == 0 and no usable feature has a missing value",
   "NumberOfClasses, NumberOfInstances and MinorityClassSize are all reported, so that the subsets can be assigned after membership",
   "not in DEVELOPMENT_IDS and its name contains no DEVELOPMENT_NAMES token",
   "its source has not already been admitted"
  ],
  "membership_uses_class_rarity": false,
  "membership_uses_class_count": "only the bound C >= 2. The smallest class size is not bounded: a data set whose smallest class is below s_min = 3 is admitted, lands in the rare subset, and counts against the method, which provably cannot retain a core there.",
  "subset_rule": "rare subset: the smallest class holds fewer than sqrt(n) points, the rare band of the manuscript, with no lower floor. locality control: otherwise, so no class is below sqrt(n) and the retention predicate provably cannot fire. A smallest class below s_min = 3 does not remove a data set from the rare subset; it stays in and counts against the method. The subset is computed after the cohort is fixed.",
  "development_ids_excluded": [
   10,
   30,
   35,
   36,
   39,
   41,
   53,
   54,
   62,
   152,
